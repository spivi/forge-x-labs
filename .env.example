PROJECT_NAME="cloudforge"
API_V1_STR="/api/v1"
SECRET_KEY=change-me-in-production

# Database (PostgreSQL) — uncomment for fastapi-modular flavor
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

# Redis — uncomment if needed
# REDIS_URL=redis://localhost:6379/0

# Session TTL (seconds) - default 10 minutes
# SESSION_TTL_SECONDS=600

# Google Stitch MCP (UI design generation — optional)
# Get your key from: https://stitch.withgoogle.com/
# STITCH_API_KEY=
