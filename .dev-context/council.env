# council.env — shared configuration for the Council Review (scripts/council-review.sh).
#
# Sourced (not executed). The wrapper is the ONE place the model/cost policy lives.
# Members are the codex + gemini CLIs/providers; the chair is Claude (Sonnet), and any
# Opus escalation is REFUSED unless the caller explicitly passes --allow-opus.
#
# Both members authenticate via their own CLI subscription — NO API keys are needed:
#   codex       -> ChatGPT login (`codex login status`)
#   antigravity -> Antigravity `agy` CLI subscription login
# (The gemini REST provider — which needed GEMINI_API_KEY — was replaced by antigravity
# because the gemini CLI's keyless tier was discontinued. agy is Google's keyless path.)

# Absolute path to the vendored, owned claude-council clone. Resolved relative to this
# file so it works regardless of where dev-template is checked out. Callers in OTHER
# projects should override COUNCIL_PLUGIN_ROOT to point at this same clone.
if [ -z "${COUNCIL_PLUGIN_ROOT:-}" ]; then
  _council_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
  COUNCIL_PLUGIN_ROOT="${_council_env_dir}/vendor/claude-council"
  unset _council_env_dir
fi
export COUNCIL_PLUGIN_ROOT

# Council roster and routing.
export COUNCIL_PROVIDERS="${COUNCIL_PROVIDERS:-codex,antigravity}"
export COUNCIL_ROLES="${COUNCIL_ROLES:-doc-review}"      # positional: codex->correctness, antigravity->coherence

# Per-member models (read by the plugin's provider scripts via these env names).
export CODEX_MODEL="${CODEX_MODEL:-gpt-5.5}"
export ANTIGRAVITY_MODEL="${ANTIGRAVITY_MODEL:-Gemini 3.5 Flash (High)}"

# Chair (synthesis) model policy — the single cost brake.
#   COUNCIL_CHAIR_MODEL is pinned to Sonnet for automatic runs.
#   COUNCIL_ALLOW_OPUS=0 => the wrapper REFUSES to run the chair on any opus model
#   unless invoked with --allow-opus (a human opt-in). Never silently escalate.
export COUNCIL_CHAIR_MODEL="${COUNCIL_CHAIR_MODEL:-claude-sonnet-4-6}"
export COUNCIL_ALLOW_OPUS="${COUNCIL_ALLOW_OPUS:-0}"

# Auto-draft of the chair's BLOCKER recommendations. off | on (default off).
#   When on, after the review the wrapper reads the chair's machine-readable
#   ```council-autofix``` block (blockers ONLY — never nice-to-haves or acceptance
#   criteria) and DRAFTS each fix as a minimal edit on a COPY of the target file,
#   appending a unified diff + summary to the report. It NEVER applies or commits —
#   a human reviews the diffs and applies them (constitution: human stays in the loop).
#   The drafting model is the Sonnet chair; Opus stays gated. Override per-run with
#   --autofix / --no-autofix.
export COUNCIL_AUTOFIX="${COUNCIL_AUTOFIX:-off}"

# KPI ledger (one row per council run). Relative to the dev-context root.
export COUNCIL_LEDGER="${COUNCIL_LEDGER:-.dev-context/kpis/council.csv}"
